APP_ENV=production
PUBLIC_BASE_URL=https://api.example.com
STORE_BACKEND=postgres

DATABASE_URL=postgresql://dreamjourney:dreamjourney@postgres:5432/dreamjourney
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT_SECONDS=5
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD
REDIS_URL=redis://redis:6379/0
BACKEND_API_TOKEN=

# Strong identity uses only keyed hashes at rest. Generate a dedicated random
# value of at least 32 bytes; never reuse a provider credential.
IDENTITY_BINDING_HMAC_KEY=
# Pin this version to the deployed HMAC key. Changing the key or version fails
# closed until an explicit identity rehash migration is performed.
IDENTITY_BINDING_HMAC_KEY_VERSION=v1
# disabled | synthetic | test | httpJson. Synthetic/test are ignored in production.
IDENTITY_CHALLENGE_ADAPTER=disabled
# Development/test only. Never configure or deploy this value in production.
IDENTITY_CHALLENGE_SYNTHETIC_CODE=
# Production-ready generic SMS gateway contract. The server POSTs a JSON body
# with challengeId, identityType, target, purpose and code, and requires
# {"accepted": true}. An optional provider-neutral status endpoint accepts
# {"challengeId": "..."} and returns deliveryState=accepted|delivered|
# undeliverable|unknown. Keep the API key server-only. An incomplete or invalid
# send configuration fails closed as providerMode=unavailable; omitting the
# status endpoint keeps verification available but marks recovery unsupported.
IDENTITY_CHALLENGE_HTTP_JSON_URL=
IDENTITY_CHALLENGE_HTTP_JSON_STATUS_URL=
IDENTITY_CHALLENGE_HTTP_JSON_API_KEY=
IDENTITY_CHALLENGE_HTTP_JSON_TIMEOUT_SECONDS=10
IDENTITY_CHALLENGE_TTL_SECONDS=300
IDENTITY_CHALLENGE_MAX_ATTEMPTS=5
IDENTITY_CHALLENGE_RETRY_AFTER_SECONDS=30
# Optional machine-managed synthetic QA account lane. Keep disabled unless the
# migration and machine-only management API have been reviewed. Prefixes use
# normalized international digits, must contain 10 to 13 digits, and targets
# are additionally restricted to the reserved 86100xxxxxxxx range.
TEST_ACCOUNT_ALLOWLIST_ENABLED=false
TEST_ACCOUNT_ALLOWED_PHONE_PREFIXES=
TEST_ACCOUNT_DEFAULT_TTL_DAYS=7
TEST_ACCOUNT_MAX_TTL_DAYS=30
# 声音复刻训练需要独立的“本人、成年人、在世、活体”核验回执。
# OTP/SMS 身份挑战不满足该合同。默认 disabled，并且训练 fail-closed。
# 启用 httpJson 时，服务端会把 actorUserId、subjectUserId 和 clonedVoice
# capability 发送到该 HTTPS endpoint；provider 必须返回短期、可核验的回执。
VOICE_IDENTITY_ELIGIBILITY_PROVIDER=disabled
VOICE_IDENTITY_ELIGIBILITY_HTTP_JSON_URL=
VOICE_IDENTITY_ELIGIBILITY_HTTP_JSON_API_KEY=
VOICE_IDENTITY_ELIGIBILITY_HTTP_JSON_TIMEOUT_SECONDS=10
# Development/test compatibility only; production always ignores this flag.
AUTH_LEGACY_PHONE_LOGIN_ENABLED=false

# Keep ownership in shadow until mismatch evidence has been reviewed.
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=2592000
# auto | shadow | enforce. auto resolves to enforce in production; invalid values stop startup.
AUTH_ROUTE_MODE=auto
AUTH_OWNERSHIP_MODE=shadow
# observe | enforce. Registry-classified USER mutations use RELEASE_POLICY_MIN_CLIENT_BUILD.
CLIENT_COMPATIBILITY_MODE=observe
# Global recovery traffic fence: normal | readOnly | signedOut | maintenance.
RECOVERY_ACCESS_MODE=normal
# Increment after a recovery cutover so clients invalidate stale authority state.
AUTHORITY_EPOCH=epoch-0
# Observe route/command policy mismatches before enabling server-side denial.
RELEASE_POLICY_COMMAND_MODE=observe
DELEGATED_ACCESS_CONTRACT_API_ENABLED=false
# Hidden Owner Truth Candidate Inbox/decision contract. Keep false in normal
# deployments; QA requires both this flag and the explicit QA request header.
OWNER_TRUTH_CANDIDATE_REVIEW_QA_ENABLED=false
# Owner-controlled family contribution contract. Keep false in normal
# deployments; QA requires this flag and x-dreamjourney-qa-owner-truth: 1.
# It permits only a static Source contribution from an explicitly granted,
# accepted family relationship. It does not grant Vault read access.
OWNER_TRUTH_FAMILY_CONTRIBUTION_QA_ENABLED=false
# Server-only, value-free audit for successful Owner natural-input appends.
# It adds no public API/UI and stays false until an operator explicitly enables it.
OWNER_TRUTH_INTERVIEW_DECISION_AUDIT_ENABLED=false
# Conservative, provider-free natural-language topic-switch shadow. It only
# affects the existing value-free audit when that audit is also enabled; it
# never pauses a session, returns message text, or exposes public UI.
OWNER_TRUTH_TOPIC_SHIFT_SHADOW_ENABLED=false
# QA-only write preflight for explicit topic changes. With the explicit QA
# request header it returns a no-write pause-for-topic-switch requirement.
OWNER_TRUTH_TOPIC_SHIFT_PREFLIGHT_QA_ENABLED=false
# Explicit do-not-ask reactivation preflight. With this switch enabled, an
# owner who clearly asks to resume a stopped topic receives a no-write restore
# confirmation requirement; it never restores the session automatically.
OWNER_TRUTH_DO_NOT_ASK_REACTIVATION_PREFLIGHT_ENABLED=false
# Server-only cadence writer for formally captured Owner natural input. It
# atomically creates a pending ReviewBatch only when the existing threshold or
# paused-session boundary is due; no batch is returned to the client.
OWNER_TRUTH_INTERVIEW_REVIEW_BATCH_AUTOMATION_ENABLED=false
# Separate Owner-confirmed knowledge-dimension receipt QA lane. It remains
# unavailable unless this flag, the Candidate QA flag, a user session and the
# explicit QA header are all present.
OWNER_TRUTH_KNOWLEDGE_DIMENSION_CONFIRMATION_QA_ENABLED=false
# M0-B recommendation QA readers remain independently closed. The plan route
# derives only value-free breadth candidates from server authority.
OWNER_TRUTH_KNOWLEDGE_RECOMMENDATION_READ_QA_ENABLED=false
OWNER_TRUTH_KNOWLEDGE_RECOMMENDATION_PLAN_QA_ENABLED=false
# Server-verified M0-B recommendation acceptance receipts. This remains
# unavailable outside explicit Owner QA and never exposes Echo UI by itself.
OWNER_TRUTH_KNOWLEDGE_RECOMMENDATION_ACTIVATION_QA_ENABLED=false
# QA-only recommendation feedback receipts. "replace" suppresses only the
# current candidate; "notInterested" is a ranking signal, never do-not-ask.
OWNER_TRUTH_KNOWLEDGE_RECOMMENDATION_FEEDBACK_QA_ENABLED=false
OWNER_TRUTH_SAVED_CONTINUATION_CUE_QA_ENABLED=false
# Read-only Phase 4A Thread/association projection. It stays unavailable
# outside explicit Owner QA and returns no memory or transcript text.
OWNER_TRUTH_THREAD_SUMMARY_READ_QA_ENABLED=false
# Independent QA-only checkpoint for the value-free Thread Summary projection.
# This does not expose a public endpoint or persist any Owner narrative text.
OWNER_TRUTH_THREAD_SUMMARY_PROJECTION_QA_ENABLED=false
# Read-only Phase 4C session result projection. It returns only current
# confirmation-derived counts and eligible continuation status during QA.
OWNER_TRUTH_INTERVIEW_SESSION_OUTCOME_READ_QA_ENABLED=false
# Read-only Phase 4C life-map projection. It returns only stable dimension
# coverage, current thread state and reversible associations during QA.
OWNER_TRUTH_LIFE_MAP_READ_QA_ENABLED=false
# Owner-only Phase 4C SearchDocument QA. This baseline performs deterministic
# text fallback and returns citation-shaped hits, never raw memory text.
OWNER_TRUTH_MEMORY_SEARCH_READ_QA_ENABLED=false
# Independent QA-only rebuild of the private SearchDocument projection.
# This does not enable public search, embeddings, or vector/provider ranking.
OWNER_TRUTH_MEMORY_SEARCH_PROJECTION_QA_ENABLED=false
# QA-only Owner topic controls.  Keep disabled in normal deployments; server
# time calculates cooldown expiry and an explicit restore is always required.
OWNER_TRUTH_THREAD_PREFERENCE_QA_ENABLED=false
OWNER_TRUTH_THREAD_COOLDOWN_SECONDS=604800
# Increment policy revision for every rollout, canary, restoration, or kill-switch change.
RELEASE_POLICY_REVISION=1
RELEASE_POLICY_MIN_CLIENT_BUILD=1
RELEASE_POLICY_TTL_SECONDS=300
# Comma-separated typed DJFeature names. Canary features enforce while global mode observes.
RELEASE_POLICY_ENFORCED_FEATURES=
# Kill switch always enforces; increment both revisions before changing this set.
RELEASE_POLICY_EMERGENCY_REVISION=0
RELEASE_POLICY_EMERGENCY_DISABLED_FEATURES=
# Closed-pilot membership is a server-owned comma-separated user-id allowlist.
# Client cohort headers and query parameters are ignored for authorization.
RELEASE_POLICY_CLOSED_PILOT_OWNER_IDS=
# Additional M0 features approved only for the server-granted pilot cohort.
# Currently supported: ownerTextCaptureV1, ownerTruthCandidateReview,
# echoGuidedRecommendations, ownerTruthLifeMap, ownerTruthFamilyContribution.
# The family contribution feature admits only explicit, static owner-truth
# materials from an accepted relationship; it never grants private Vault reads.
RELEASE_POLICY_CLOSED_PILOT_FEATURES=
# Short-lived operational evidence independently controls each Provider-backed
# lane. Expired evidence fails closed; a recovered lane receives a new opaque
# readiness epoch so clients cannot reuse a pre-outage decision. Backlog and
# dead-letter limits apply only to the typed media-processing job lane.
RUNTIME_CAPABILITY_READINESS_TTL_SECONDS=180
RUNTIME_CAPABILITY_PROBE_INTERVAL_SECONDS=5
RUNTIME_CAPABILITY_BACKLOG_LIMIT=50
RUNTIME_CAPABILITY_DEAD_LETTER_LIMIT=0
# V4 async-effect kernel stays default-disabled in ordinary API deployments.
# No existing business route needs these worker flags.
ASYNC_EFFECT_V1_ENABLED=false
ASYNC_EFFECT_WORKER_ENABLED=false
# Voice-profile deletion first revokes all local synthesis. This worker only
# records a provider cleanup result when a reviewed adapter supports deletion;
# the current VolcEngine train/query adapter reports unsupported/partial.
VOICE_CLONE_DELETION_WORKER_ENABLED=false
# Idle delay used only by the explicit owner-truth-worker Compose profile.
OWNER_TRUTH_WORKER_POLL_SECONDS=2
# Private deterministic Source -> Candidate extraction requires both flags
# above plus this explicit worker switch. It has no public route or Provider.
OWNER_TRUTH_CANDIDATE_EXTRACTION_WORKER_ENABLED=false
# Owner Truth projection rebuild requires both flags above plus this explicit
# opt-in. It is not a public feature switch and must remain false unless an
# operator deliberately starts the one-shot typed worker.
OWNER_TRUTH_MEMORY_PROJECTION_WORKER_ENABLED=false
# Chain the private SearchDocument rebuild only after the source projection
# succeeds. It requires the three flags above and remains off by default; it
# does not enable a public search, vector, or provider retrieval surface.
OWNER_TRUTH_MEMORY_SEARCH_PROJECTION_WORKER_ENABLED=false
# Closed-pilot only: when true, eligible personal Echo requests use current
# confirmed V4 MemoryProjection Context instead of legacy Archive/KBLite.
# Keep false until the server-owned allowlist and Owner Truth worker profile
# have been verified in the target environment.
OWNER_TRUTH_CONTEXT_AUTHORITY_CLOSED_PILOT_ENABLED=false
# Stage 2 private media ingestion. Keep disabled until the private volume and
# a real content-safety scanner are deliberately configured. `filesystem`
# stores bytes only inside the Docker volume; it never exposes a public URL.
# `testClean` is rejected in production and exists only for local contract
# tests. The preferred production path is the optional internal ClamAV sidecar:
# set provider=clamav and host=clamav only after starting the
# owner-truth-media-safety Compose profile. Do not publish its TCP port.
OWNER_TRUTH_MEDIA_CAPTURE_ENABLED=false
OWNER_TRUTH_MEDIA_STORAGE_PROVIDER=disabled
OWNER_TRUTH_MEDIA_STORAGE_ROOT=/var/lib/dreamjourney/media
# M0 production uses a private Tencent COS bucket through its S3-compatible
# endpoint. Do not configure a public bucket, a public ACL, static website
# hosting, or object URLs. The API receives/uploads bytes itself and these
# credentials only live in the server .env. When capture is enabled, bucket,
# region, endpoint, least-privilege credentials and explicit SSE are all
# required; incomplete configuration remains fail-closed.
OWNER_TRUTH_MEDIA_S3_BUCKET=
OWNER_TRUTH_MEDIA_S3_PREFIX=dreamjourney/private-media
OWNER_TRUTH_MEDIA_S3_REGION=
OWNER_TRUTH_MEDIA_S3_ENDPOINT_URL=
OWNER_TRUTH_MEDIA_S3_ACCESS_KEY_ID=
OWNER_TRUTH_MEDIA_S3_SECRET_ACCESS_KEY=
# Required for an enabled COS adapter: AES256 (SSE-COS) or cos/kms (SSE-KMS).
# For generic S3 compatibility tests use AES256 or aws:kms. Leave the KMS key
# empty when the provider default key is intended.
OWNER_TRUTH_MEDIA_S3_SERVER_SIDE_ENCRYPTION=
OWNER_TRUTH_MEDIA_S3_KMS_KEY_ID=
OWNER_TRUTH_MEDIA_UPLOAD_INTENT_TTL_SECONDS=900
OWNER_TRUTH_MEDIA_MAX_UPLOAD_BYTES=52428800
OWNER_TRUTH_MEDIA_CONTENT_SAFETY_PROVIDER=disabled
# Blank host preserves the legacy local clamscan adapter. An explicit host uses
# the clamd INSTREAM sidecar and fails closed if it is offline, slow, or has no
# usable signature database. Keep this Docker-internal service name; never use
# a public endpoint for unauthenticated clamd TCP.
OWNER_TRUTH_MEDIA_CLAMAV_HOST=
OWNER_TRUTH_MEDIA_CLAMAV_PORT=3310
OWNER_TRUTH_MEDIA_CLAMAV_TIMEOUT_SECONDS=30
# Enables the separate private parser/OCR/ASR worker only after capture,
# persistent storage and content-safety scanning have been verified.
OWNER_TRUTH_MEDIA_PROCESSING_WORKER_ENABLED=false
# Physical deletion remains an independent kill switch. Enable it only after
# the private object adapter has passed PUT/HEAD/readback/delete verification;
# access revocation remains authoritative while this worker is disabled.
OWNER_TRUTH_MEDIA_DELETION_WORKER_ENABLED=false
# Internal metadata-only business message projection is a separate worker
# profile. It does not write the public mailbox or dispatch notifications.
BUSINESS_MESSAGE_PROJECTION_WORKER_ENABLED=false
# P2-S4C lifecycle cleanup reconciliation is a separate default-off worker.
# It creates only redacted `pending` cleanup effects after local access denial;
# it does not call public index, cache, Digital Human, voice, or storage
# Providers. Start it only in the explicit closed-beta profile below.
PUBLICATION_EXTERNAL_CLEANUP_MATERIALIZER_ENABLED=false
# Optional private OCR/ASR adapter contract. Keep both providers disabled by
# default. `httpJson` requires an HTTPS endpoint and a server-side bearer key;
# the worker sends no object URL, filename, owner id or vault id. It sends bytes
# only when the upload intent explicitly set allowExternalProcessing=true.
# The adapter must return JSON with a non-empty `text` or `transcript` string.
OWNER_TRUTH_MEDIA_IMAGE_OCR_PROVIDER=disabled
OWNER_TRUTH_MEDIA_IMAGE_OCR_URL=
OWNER_TRUTH_MEDIA_IMAGE_OCR_API_KEY=
OWNER_TRUTH_MEDIA_AUDIO_ASR_PROVIDER=disabled
OWNER_TRUTH_MEDIA_AUDIO_ASR_URL=
OWNER_TRUTH_MEDIA_AUDIO_ASR_API_KEY=
OWNER_TRUTH_MEDIA_EXTERNAL_PROCESSOR_TIMEOUT_SECONDS=30
OWNER_TRUTH_MEDIA_EXTERNAL_PROCESSOR_MAX_PAYLOAD_BYTES=10485760
# Isolated local TXT/PDF/DOCX parser limits. They apply inside the media worker
# and do not turn on capture, OCR, ASR, or any external Provider.
OWNER_TRUTH_DOCUMENT_PARSER_TIMEOUT_SECONDS=15
OWNER_TRUTH_DOCUMENT_PARSER_MAX_INPUT_BYTES=20971520
OWNER_TRUTH_DOCUMENT_PARSER_MAX_MEMORY_BYTES=536870912
OWNER_TRUTH_DOCUMENT_PARSER_MAX_CPU_SECONDS=10
OWNER_TRUTH_DOCUMENT_PARSER_MAX_PDF_PAGES=100
OWNER_TRUTH_DOCUMENT_PARSER_MAX_DOCX_ENTRIES=2048
OWNER_TRUTH_DOCUMENT_PARSER_MAX_DOCX_UNCOMPRESSED_BYTES=20971520
OWNER_TRUTH_DOCUMENT_PARSER_MAX_DOCX_COMPRESSION_RATIO=200
# The async-effect worker and scheduler are opt-in Docker Compose profiles.
# The generic foundations only perform value-free shadow observations. The
# Owner Truth Candidate/Projection workers use their own explicit profile.
# docker compose --profile async-effect-worker run --rm async-effect-worker
# docker compose --profile async-effect-scheduler run --rm async-effect-scheduler
# docker compose --profile owner-truth-worker up -d \
#   owner-truth-candidate-extraction-worker owner-truth-memory-projection-worker
# docker compose --profile owner-truth-media-worker up -d \
#   owner-truth-media-processing-worker owner-truth-media-deletion-worker
# docker compose --profile publication-lifecycle-worker up -d \
#   publication-external-cleanup-materializer-worker
EVIDENCE_ROLLOUT_RETENTION_DAYS=30
# Dedicated 32+ byte HMAC key for request/operation/attempt evidence IDs.
# Never reuse an identity, provider, API, or session credential. Without this
# value, shadow metrics use a process-local key and cannot safely correlate
# operation retries across an API restart.
OPERATIONS_EVIDENCE_HMAC_KEY=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/chat/completions

VOLCENGINE_API_KEY=
VOLCENGINE_VOICE_TYPE=zh_female_cancan_mars_bigtts
VOLCENGINE_APP_ID=
VOLCENGINE_APP_KEY=YOUR_VOLCENGINE_APP_KEY
VOLCENGINE_APP_TOKEN=
VOLCENGINE_REALTIME_RESOURCE_ID=volc.speech.dialog
VOLCENGINE_REALTIME_ADDRESS=wss://openspeech.bytedance.com
VOLCENGINE_REALTIME_URI=/api/v3/realtime/dialogue
VOLCENGINE_VOICE_CLONE_API_KEY=
VOLCENGINE_VOICE_CLONE_TRAIN_URL=https://openspeech.bytedance.com/api/v3/tts/voice_clone
VOLCENGINE_VOICE_CLONE_QUERY_URL=https://openspeech.bytedance.com/api/v3/tts/get_voice
VOLCENGINE_VOICE_CLONE_UPGRADE_URL=https://openspeech.bytedance.com/api/v3/tts/upgrade_voice
VOLCENGINE_VOICE_CLONE_SPEAKER_ID_MODE=customSpeakerId
# VOLCENGINE_VOICE_CLONE_SPEAKER_ID=S_xxxxxxxx
# 声音复刻 2.0 试用槽位可切到 trialSpeakerIdPool，并填控制台赠送的 S_ 音色 ID 列表。
# 后端会把这些槽持久化独占分配给逻辑 voiceProfileId；删除后槽位退休，不会自动复用。
# 试用槽数量就是可绑定 profile 的上限，生产环境应配置足够容量或切换正式资源。
# VOLCENGINE_VOICE_CLONE_SPEAKER_ID_MODE=trialSpeakerIdPool
# VOLCENGINE_VOICE_CLONE_SPEAKER_IDS=S_xxxxxxxx,S_yyyyyyyy
VOLCENGINE_VOICE_CLONE_MODEL_TYPE=5
VOLCENGINE_VOICE_CLONE_TTS_API_KEY=
VOLCENGINE_VOICE_CLONE_TTS_URL=https://openspeech.bytedance.com/api/v1/tts
VOLCENGINE_VOICE_CLONE_TTS_CLUSTER=volcano_icl
VOLCENGINE_VOICE_CLONE_TTS_RESOURCE_ID=seed-icl-2.0

AMAP_WEB_SERVICE_KEY=

# Tencent Cloud Digital Human cloud-rendering session.
# APP_KEY and ACCESS_TOKEN come from the Tencent digital-human session/API console.
# Configure exactly one render asset source: ASSET_VIRTUALMAN_KEY or VIRTUALMAN_PROJECT_ID.
TENCENT_DIGITAL_HUMAN_APP_KEY=
TENCENT_DIGITAL_HUMAN_ACCESS_TOKEN=
TENCENT_DIGITAL_HUMAN_ASSET_VIRTUALMAN_KEY=
TENCENT_DIGITAL_HUMAN_VIRTUALMAN_PROJECT_ID=
# ASR-only fields. Leave empty unless Tencent ASR is enabled.
TENCENT_DIGITAL_HUMAN_APP_ID=
TENCENT_DIGITAL_HUMAN_SECRET_ID=
TENCENT_DIGITAL_HUMAN_SECRET_KEY=

# APNs delivery. `fake` is QA-only. Production token authentication requires
# `appleToken`, the encrypted PostgreSQL token vault and a host-mounted .p8
# file with mode 600. Never paste the private key into this env file.
APNS_DELIVERY_PROVIDER=disabled
APNS_TOKEN_VAULT_PROVIDER=disabled
APNS_TOPIC=com.yxj.dreamjourney.app
APNS_ENVIRONMENT=sandbox
APNS_MAX_ATTEMPTS=3
# Required only when APNS_TOKEN_VAULT_PROVIDER=postgresEncrypted. Generate with:
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
APNS_TOKEN_ENCRYPTION_KEY=
APNS_TOKEN_ENCRYPTION_KEY_VERSION=v1
APNS_TEAM_ID=
APNS_KEY_ID=
# Host path is consumed by Docker Compose; container path is consumed by the
# backend. Keep the .p8 outside the repository and set mode 600.
APNS_PRIVATE_KEY_HOST_PATH=
APNS_PRIVATE_KEY_PATH=
APNS_REQUEST_TIMEOUT_SECONDS=15
APNS_WORKER_BATCH_SIZE=25
APNS_WORKER_LEASE_SECONDS=60
APNS_WORKER_POLL_SECONDS=5
# Set true only after Apple has accepted a controlled test notification in the
# matching topic/environment. This affects readiness reporting, not auth.
APNS_EXTERNAL_VERIFIED=false
